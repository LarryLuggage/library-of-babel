# Browser-safe Supabase connection details.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for privileged seed ingestion.
# SUPABASE_SERVICE_ROLE_KEY is supported as a legacy fallback.
SUPABASE_SECRET_KEY=

# Bearer token required by POST /api/books/seed.
BOOK_SEED_TOKEN=

# Optional in local dev (when unset, local writes are open; required in production).
# Sets the curator passphrase used to mint a signed HTTP-only session cookie.
BOOK_OWNER_PASSPHRASE=

# Optional HMAC signing secret for curator session cookies (defaults to a key derived from BOOK_OWNER_PASSPHRASE).
BOOK_SESSION_SECRET=

# Optional API key for Google Books enrichment in /api/books/lookup and npm run enrich:books.
GOOGLE_BOOKS_API_KEY=
